#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Layer indices. Used everywhere a layer is referenced so the bindings stay
// self-documenting and renumbering is a one-line change.
#define BASE   0
#define TAP    1
#define EXTRA  2
#define NAV    3
#define NUM    4
#define SYM    5
#define ADJUST 6
#define MOUSE  7
// 8 (extra4) and 9 are reserved/spare slots for ZMK Studio runtime layers.

/ {
    combos {
        compatible = "zmk,combos";

        unlock {
            bindings = <&studio_unlock>;
            key-positions = <0 11>;
        };
    };

    behaviors {
        // Layer-tap: hold = momentary layer, tap = keypress.
        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "U_LT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            bindings = <&mo>, <&kp>;
        };

        // SHIFT tier, left hand (T): balanced, eager hold so mid-flow capitals
        // fire on a cross-hand roll. Kept "as it stands now" (idle 150).
        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_L";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 18 30 44 56 57 45 31 19 7 8 20 32 46 58 59 47 33 21 9 10 22 34 48 49 35 23 11 55 43>;
            hold-trigger-on-release;
        };

        // SHIFT tier, right hand (N): mirror of hm_shift_l.
        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_R";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 12 24 36 37 25 13 1 2 14 26 38 50 51 39 27 15 3 4 28 16 40 52 53 41 17 29 5 54 42>;
            hold-trigger-on-release;
        };

        // ---- SHIFT tuning ladder (ZMK Studio scratch variants) -------------
        // Identical to hm_shift_l/r except require-prior-idle-ms. Lower idle =
        // hold can fire sooner after a prior key = fewer `ti` false-negatives
        // (at a small cost in benign stray-capital misfires). Flip T/N to a
        // lower-numbered variant in Studio if `ti` lingers; bake the winner
        // into hm_shift_l/r and delete these once tuned. Kept in the build by
        // ZMK_BEHAVIORS_KEEP_ALL, which the studio-rpc-usb-uart snippet in
        // build.yaml auto-defines for both halves (a preprocessor flag, not a
        // CONFIG_ Kconfig symbol — so nothing to set in sofle.conf).
        //   base hm_shift_l/r = 150  →  120  →  90  →  60  →  30
        // --------------------------------------------------------------------

        hm_shift_l_120: hm_shift_l_120 {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_L_120";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 18 30 44 56 57 45 31 19 7 8 20 32 46 58 59 47 33 21 9 10 22 34 48 49 35 23 11 55 43>;
            hold-trigger-on-release;
        };
        hm_shift_r_120: hm_shift_r_120 {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_R_120";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 12 24 36 37 25 13 1 2 14 26 38 50 51 39 27 15 3 4 28 16 40 52 53 41 17 29 5 54 42>;
            hold-trigger-on-release;
        };

        hm_shift_l_90: hm_shift_l_90 {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_L_90";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <90>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 18 30 44 56 57 45 31 19 7 8 20 32 46 58 59 47 33 21 9 10 22 34 48 49 35 23 11 55 43>;
            hold-trigger-on-release;
        };
        hm_shift_r_90: hm_shift_r_90 {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_R_90";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <90>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 12 24 36 37 25 13 1 2 14 26 38 50 51 39 27 15 3 4 28 16 40 52 53 41 17 29 5 54 42>;
            hold-trigger-on-release;
        };

        hm_shift_l_60: hm_shift_l_60 {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_L_60";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <60>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 18 30 44 56 57 45 31 19 7 8 20 32 46 58 59 47 33 21 9 10 22 34 48 49 35 23 11 55 43>;
            hold-trigger-on-release;
        };
        hm_shift_r_60: hm_shift_r_60 {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_R_60";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <60>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 12 24 36 37 25 13 1 2 14 26 38 50 51 39 27 15 3 4 28 16 40 52 53 41 17 29 5 54 42>;
            hold-trigger-on-release;
        };

        hm_shift_l_30: hm_shift_l_30 {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_L_30";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <30>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 18 30 44 56 57 45 31 19 7 8 20 32 46 58 59 47 33 21 9 10 22 34 48 49 35 23 11 55 43>;
            hold-trigger-on-release;
        };
        hm_shift_r_30: hm_shift_r_30 {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_R_30";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <30>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 12 24 36 37 25 13 1 2 14 26 38 50 51 39 27 15 3 4 28 16 40 52 53 41 17 29 5 54 42>;
            hold-trigger-on-release;
        };

        // MOD tier, left hand (GUI/ALT/CTRL): tap-preferred baseline reverted
        // to the proven pre-refactor settings. Only triggers on a right-hand key.
        hm_mod_l: hm_mod_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_MOD_L";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <240>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 18 30 44 56 57 45 31 19 7 8 20 32 46 58 59 47 33 21 9 10 22 34 48 49 35 23 11 55 43>;
        };

        // MOD tier, right hand: mirror of hm_mod_l. Only triggers on a left-hand key.
        hm_mod_r: hm_mod_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_MOD_R";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <240>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 12 24 36 37 25 13 1 2 14 26 38 50 51 39 27 15 3 4 28 16 40 52 53 41 17 29 5 54 42>;
        };

        // RGB controls: tap = increase, shift+tap = decrease.
        u_rgb_hue: u_rgb_hue {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_HUE";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;
        };

        u_rgb_sat: u_rgb_sat {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_SAT";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&rgb_ug RGB_SAI>, <&rgb_ug RGB_SAD>;
        };

        u_rgb_brt: u_rgb_brt {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_BRT";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        u_rgb_spe: u_rgb_spe {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_SPE";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&rgb_ug RGB_SPI>, <&rgb_ug RGB_SPD>;
        };

        // Pointer: tap = move, shift+tap = scroll.
        u_mse_up: u_mse_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MOUSE/SCROLL_UP";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&mmv MOVE_UP>, <&msc SCRL_UP>;
        };

        u_mse_dn: u_mse_dn {
            compatible = "zmk,behavior-mod-morph";
            label = "MOUSE/SCROLL_DN";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&mmv MOVE_DOWN>, <&msc SCRL_DOWN>;
        };

        u_mse_lft: u_mse_lft {
            compatible = "zmk,behavior-mod-morph";
            label = "MOUSE/SCROLL_LFT";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&mmv MOVE_LEFT>, <&msc SCRL_LEFT>;
        };

        u_mse_rgt: u_mse_rgt {
            compatible = "zmk,behavior-mod-morph";
            label = "MOUSE/SCROLL_RGT";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&mmv MOVE_RIGHT>, <&msc SCRL_RIGHT>;
        };

        // Tap-dances: tap once = nothing, tap twice = the action (guards
        // against accidental layer/bootloader/base switches).
        u_td_base: u_td_base {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TD_BASE";
            #binding-cells = <0>;
            bindings = <&none>, <&to BASE>;
        };

        u_td_qwerty: u_td_qwerty {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TD_QWERTY";
            #binding-cells = <0>;
            bindings = <&none>, <&to EXTRA>;
        };

        u_td_tap: u_td_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TD_TAP";
            #binding-cells = <0>;
            bindings = <&none>, <&to TAP>;
        };

        u_td_boot: u_td_boot {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TD_BOOT";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };
    };

    macros {
        u_work_email: u_work_email {
            compatible = "zmk,behavior-macro";
            label = "WORK_EMAIL";
            #binding-cells = <0>;
            tap-ms = <5>;
            bindings = <&kp C &kp B &kp R &kp O &kp M &kp P &kp T &kp O &kp N &kp AT &kp D &kp E &kp L &kp T &kp A &kp C &kp O &kp N &kp T &kp R &kp O &kp L &kp S &kp DOT &kp C &kp O &kp M>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  F   |  P   |  B   |                   |  J   |  L    |  U    |  Y   |   ;   | BKSPC |
            // |  TAB  |  A  |  R  |  S   |  T   |  G   |                   |  M   |  N    |  E    |  I   |   O   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  D   |  V   |  MUTE  |  |       |  K   |  H    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | ENTER|  LOWER |  | RAISE | SPACE| CTRL  | ALT   | GUI  |

            bindings = <
&none  &kp N1          &kp N2          &kp N3           &kp N4           &kp N5                                       &kp N6         &kp N7           &kp N8           &kp N9          &kp N0               &kp BSPC
&none  &kp Q           &kp W           &kp F            &kp P            &kp B                                        &kp J          &kp L            &kp U            &kp Y           &kp SEMI             &none
&none  &hm_mod_l LGUI A  &hm_mod_l LALT R  &hm_mod_l LCTRL S  &hm_shift_l LSHFT T  &kp G                                        &kp M          &hm_shift_r RSHFT N  &hm_mod_r RCTRL E  &hm_mod_r RALT I  &hm_mod_r RIGHT_GUI O  &kp APOS
&none  &kp Z           &kp X           &kp C            &kp D            &kp V       &kp C_MUTE  &kp PSCRN            &kp K          &kp H            &kp COMMA        &kp DOT         &kp FSLH             &none
                       &u_work_email     &mo MOUSE        &u_lt ADJUST ESC  &u_lt NAV ENTER  &u_lt NUM TAB  &u_lt BASE BACKSPACE  &u_lt SYM SPACE  &u_lt BASE DELETE  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Tap {
            display-name = "Tap";

            bindings = <
&kp ESC    &kp N1  &kp N2     &kp N3    &kp N4                 &kp N5                                            &kp N6         &kp N7           &kp N8     &kp N9     &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W      &kp F     &kp P                  &kp B                                             &kp J          &kp L            &kp U      &kp Y      &kp SEMI  &none
&kp CAPS   &kp A   &kp R      &kp S     &kp T                  &kp G                                             &kp M          &kp N            &kp E      &kp I      &kp O     &none
&kp LSHFT  &kp Z   &kp X      &kp C     &kp D                  &kp V          &kp C_MUTE  &none                 &kp K          &kp H            &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                   &kp LCTRL  &kp LGUI  &u_lt ADJUST LEFT_ALT  &u_lt NAV ENTER  &u_lt NUM TAB  &u_lt BASE BACKSPACE  &u_lt SYM SPACE  &u_lt BASE DELETE  &kp RGUI  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Qwerty {
            display-name = "QWERTY";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4              &kp N5                          &kp N6   &kp N7     &kp N8     &kp N9    &kp N0    &none
&kp ESC    &kp Q   &kp W     &kp E     &kp R               &kp T                           &kp Y    &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F               &kp G                           &kp H    &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V               &kp B   &kp C_MUTE  &none       &kp N    &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &u_lt ADJUST LCTRL  &mo NAV  &kp RET    &kp SPACE   &mo SYM  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Nav {
            display-name = "Nav";

            bindings = <
&none  &none     &none        &none          &none         &none                     &none          &none           &none           &none            &none       &none
&none  &u_td_boot   &u_td_tap  &u_td_qwerty  &u_td_base  &none                     &kp PG_UP      &kp HOME        &kp UP_ARROW    &kp END          &kp INS     &none
&none  &kp LGUI  &kp LALT     &kp LCTRL      &kp LSHFT     &none                     &kp PG_DN      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &caps_word  &none
&none  &none     &none        &none          &none         &none   &none     &none   &kp LG(LS(Y))  &kp LG(X)       &kp LG(C)       &kp LG(V)        &kp LG(Z)   &none
                 &none        &none          &trans        &trans  &trans    &trans  &trans         &trans          &none           &none
            >;
        };

        Num {
            display-name = "Num";

            bindings = <
&none  &none     &none        &none          &none         &none                    &none      &kp ESC  &kp FSLH  &kp ASTRK  &kp MINUS  &none
&none  &u_td_boot   &u_td_tap  &u_td_qwerty  &u_td_base  &none                    &kp PG_UP  &kp N7   &kp N8    &kp N9     &kp PLUS   &none
&none  &kp LGUI  &kp LALT     &kp LCTRL      &kp LSHFT     &none                    &kp PG_DN  &kp N4   &kp N5    &kp N6     &kp EQUAL  &none
&none  &none     &none        &none          &none         &none   &none     &none  &none      &kp N1   &kp N2    &kp N3     &kp ENTER  &none
                 &none        &none          &trans        &trans  &trans    &none  &kp N0     &kp N0   &kp N0    &kp DOT
            >;
        };

        Sym {
            display-name = "Sym";

            bindings = <
&none  &none           &none             &none              &none                 &none                                       &none   &none         &none          &none        &none     &none
&none  &kp LEFT_BRACE  &kp AMPS          &kp ASTRK          &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE                             &none   &u_td_base  &u_td_qwerty  &u_td_tap  &u_td_boot   &none
&none  &kp COLON       &kp DOLLAR        &kp PERCENT        &kp CARET             &kp PLUS                                    &none   &kp LSHFT     &kp LCTRL      &kp LALT     &kp LGUI  &none
&none  &kp TILDE       &kp EXCL          &kp AT             &kp POUND             &kp BACKSLASH          &none        &none   &none   &none         &none          &none        &none     &none
                       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER    &trans  &trans  &trans        &none          &none
            >;
        };

        Adjust {
            display-name = "Adjust";

            bindings = <
&none  &none     &none        &none          &none         &none                    &none            &none            &none         &none         &none         &none
&none  &u_td_boot   &u_td_tap  &u_td_qwerty  &u_td_base  &none                    &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &kp LGUI  &kp LALT     &kp LCTRL      &kp LSHFT     &none                    &none            &none            &none         &none         &none         &none
&none  &none     &none        &none          &none         &none   &none     &none  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &u_rgb_hue      &u_rgb_sat      &u_rgb_brt      &u_rgb_spe
                 &none        &none          &trans        &trans  &trans    &none  &none            &none            &none         &none
            >;
        };

        Mouse {
            display-name = "Mouse";

            bindings = <
&none  &none     &none        &none          &none         &none                        &none      &none         &none      &none           &none       &none
&none  &u_td_boot   &u_td_tap  &u_td_qwerty  &u_td_base  &none                        &kp PG_UP  &msc SCRL_UP  &u_mse_up    &msc SCRL_DOWN  &kp INS     &none
&none  &kp LGUI  &kp LALT     &kp LCTRL      &kp LSHFT     &none                        &kp PG_DN  &u_mse_lft      &u_mse_dn    &u_mse_rgt        &caps_word  &none
&none  &none     &none        &none          &none         &none   &none     &none      &kp LC(Y)  &kp LC(X)     &kp LC(C)  &kp LC(V)       &kp LC(Z)   &none
                 &none        &none          &trans        &trans  &trans    &mkp RCLK  &mkp LCLK  &mkp MCLK     &none      &none
            >;
        };

        // Reserved/spare slots so ZMK Studio can add layers at runtime.
        extra4 { status = "reserved"; };

        Spare {
            display-name = "Spare";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
